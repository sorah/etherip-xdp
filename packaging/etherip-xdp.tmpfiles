# Shared runtime dir for the control sockets and config drop-ins. setgid so
# socket-activated per-device subdirs inherit the group; 2750 keeps out other users.
d /run/etherip-xdp 2750 root etherip-xdp-sock -
# bpffs pin root for graceful restart. setgid so pins created by one instance's
# DynamicUser uid stay reachable by the next one via the group.
d /sys/fs/bpf/etherip-xdp 2770 root etherip-xdp-sock -
